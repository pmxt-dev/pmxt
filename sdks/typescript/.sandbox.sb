(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/Users"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29/pmxt-dev-pmxt-2423"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29/pmxt-dev-pmxt-2423/repo"))
(allow file-read-metadata (literal "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29/pmxt-dev-pmxt-2423/repo/sdks"))
(allow file-read-metadata (literal "/opt"))
(allow file-read-metadata (literal "/private/var"))
(allow file-read-metadata (literal "/private/var/select"))
(allow file-read-metadata (literal "/var"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/opt/homebrew"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29/pmxt-dev-pmxt-2423/repo/sdks/typescript"))
(allow file-read* (literal "/var/select/developer_dir"))
(allow file-read* (literal "/private/var/select/developer_dir"))
(allow file-read* (literal "/etc/protocols"))
(allow file-read* (literal "/etc/services"))
(allow file-read* (literal "/etc/resolv.conf"))
(allow file-write* (subpath "/Users/ibrahimyildiz/Library/Application Support/Contributor/runs/2026-10-29/pmxt-dev-pmxt-2423/repo/sdks/typescript"))
(allow file-read* file-write* (literal "/dev/null"))
(allow file-read* file-write* (literal "/dev/urandom"))
(allow network*)
